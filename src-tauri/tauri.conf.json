{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "garite",
  "version": "0.1.0",
  "identifier": "app.darakbang.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "개릿",
        "width": 320,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNkQyQzQ4RDQ1MDk3OEIKUldTTGwxRFVTQ3h0UWFLcWlmQ0JXM2xTeWN1L1VxbUVPUEtTZkhJVThiQXRnYVJKMllwV2xCbGwK",
      "endpoints": [
        "https://github.com/chazzeling/garite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
